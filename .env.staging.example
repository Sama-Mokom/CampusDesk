# Images must use immutable digest references.
BACKEND_IMAGE=000000000000.dkr.ecr.eu-north-1.amazonaws.com/campusdesk_backend@sha256:REPLACE_WITH_DIGEST
FRONTEND_IMAGE=000000000000.dkr.ecr.eu-north-1.amazonaws.com/campusdesk_frontend@sha256:REPLACE_WITH_DIGEST
MYSQL_IMAGE=mysql:8.4@sha256:REPLACE_WITH_DIGEST

APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

DB_DATABASE=campusdesk
DB_USERNAME=campusdesk
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD

MAIL_MAILER=log
MAIL_FROM_ADDRESS=campusdesk@example.com
MAIL_FROM_NAME=CampusDesk

BROADCAST_CONNECTION=reverb
REALTIME_DELIVERY_ENABLED=true
REALTIME_REPLAY_HISTORICAL_BACKLOG=true

REVERB_APP_ID=campusdesk
REVERB_APP_KEY=REPLACE_WITH_RANDOM_KEY
REVERB_APP_SECRET=REPLACE_WITH_RANDOM_SECRET
REVERB_ALLOWED_ORIGINS=http://localhost:8080